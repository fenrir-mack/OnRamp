# Local PostgreSQL connection used by npm run db:setup and npm run dev
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=onramp
PGUSER=postgres
PGPASSWORD=change_me
PGSSL=false
API_PORT=3000
ONRAMP_FILE_STORAGE_PROVIDER=local
ONRAMP_FILE_STORAGE_PATH=storage/files
# For Azure Blob Storage, set the provider to azure and configure:
# ONRAMP_FILE_STORAGE_PROVIDER=azure
# AZURE_STORAGE_ACCOUNT_NAME=onramp
# AZURE_STORAGE_CONTAINER_NAME=onramp-files
