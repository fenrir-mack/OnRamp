{
  "name": "onramp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"vite\"",
    "dev:api": "node --watch --env-file=.env server/index.js",
    "start": "node server/index.js",
    "db:setup": "node --env-file=.env scripts/setup-local-db.js",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
